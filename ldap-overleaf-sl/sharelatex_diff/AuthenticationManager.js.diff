+  async _checkCredentials(query, password) {
+    const user = await UserGetter.promises.getUser(query)
+    if (typeof password !== 'string' || password.length === 0) {
+      return { user, match: false }
+    }
+    if (/^(true|1|yes)$/i.test(process.env.ALLOW_EMAIL_LOGIN || '') && user?.hashedPassword) {
+      const local = await AuthenticationManager._checkUserPassword(query, password)
+      if (local.match) {
+        return local
+      }
+    }
+    const identity = await AuthenticationManager.ldapAuth(query, password)
+    if (!identity) {
+      return { user, match: false }
+    }
+    return {
+      user: await AuthenticationManager.provisionExternalUser(identity),
+      match: true,
+      external: true,
+    }
+  },
+
+  async provisionExternalUser({ email, first_name, last_name, isAdmin = false }) {
+    email = typeof email === 'string' ? EmailHelper.parseEmail(email) : null
+    if (!email) {
+      throw new InvalidEmailError({ message: 'email not valid' })
+    }
+    let user = await UserGetter.promises.getUserByMainEmail(email)
+    if (user) {
+      return user
+    }
+    const UserRegistrationHandler = require('../User/UserRegistrationHandler')
+    try {
+      user = await UserRegistrationHandler.promises.registerNewUser({
+        email,
+        first_name: first_name || '',
+        last_name: last_name || '',
+        password: crypto.randomBytes(32).toString('hex'),
+      })
+    } catch (error) {
+      if (error.message === 'EmailAlreadyRegistered') {
+        user = await UserGetter.promises.getUserByMainEmail(email)
+        if (user) {
+          return user
+        }
+      }
+      throw error
+    }
+    const result = await User.updateOne(
+      { _id: user._id, 'emails.email': email },
+      { $set: { isAdmin: isAdmin === true, 'emails.$.confirmedAt': new Date() } }
+    ).exec()
+    if (result.matchedCount !== 1) {
+      throw new Error('Could not confirm external user email')
+    }
+    user = await UserGetter.promises.getUserByMainEmail(email)
+    if (!user) {
+      throw new Error('External user not found after registration')
+    }
+    return user
+  },
